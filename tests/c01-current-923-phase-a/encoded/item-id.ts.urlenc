%2F%2A%2A%0A%20%2A%20OWNER%20CONTRACT%20%E2%80%94%20ItemId%20Owner.%0A%20%2A%20Owns%3A%20canonical%20Product%20Item%20UUID%20branding%2C%20parsing%2C%20and%20generation.%0A%20%2A%20Does%20not%20own%3A%20paths%2C%20Source%20identity%2C%20hashes%2C%20persistence%2C%20or%20rename%2Freappearance%20policy.%0A%20%2A%20Consumers%20must%20use%20this%20API%20instead%20of%20treating%20a%20path%2Fhash%2Farbitrary%20string%20as%20ItemId.%0A%20%2A%2F%0Aimport%20%7B%20parseCanonicalProductUuid%20%7D%20from%20%27%40%2Fcore%2Fknowledge%2Fproduct-model%27%3B%0A%0Aexport%20type%20ItemId%20%3D%20string%20%26%20%7B%20readonly%20__itemId%3A%20unique%20symbol%20%7D%3B%0A%0Aexport%20function%20parseItemId%28value%3A%20unknown%29%3A%20ItemId%20%7B%0A%20%20return%20parseCanonicalProductUuid%28value%2C%20%27ITEM_ID_INVALID%27%29%20as%20ItemId%3B%0A%7D%0A%0Aexport%20function%20createItemId%28%29%3A%20ItemId%20%7B%0A%20%20return%20parseItemId%28globalThis.crypto.randomUUID%28%29%29%3B%0A%7D%0A%0A%2F%2A%2A%20Compatibility%20name%20for%20existing%20consumers%3B%20now%20performs%20canonical%20UUID%20validation.%20%2A%2F%0Aexport%20function%20itemId%28value%3A%20string%29%3A%20ItemId%20%7B%0A%20%20return%20parseItemId%28value%29%3B%0A%7D%0A